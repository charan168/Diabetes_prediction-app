# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/disease_prediction

# Basic auth protecting the dashboard endpoints (/api/predictions, /api/metrics, /api/model-evaluation)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-please

# Python / model
PYTHON_BIN=python3
